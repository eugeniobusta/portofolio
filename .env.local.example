# ──────────────────────────────────────────────────────────────
# EmailJS Configuration — Contact Form
# ──────────────────────────────────────────────────────────────
#
# SETUP GUIDE (5 minutes):
#
# 1. Go to https://www.emailjs.com and create a free account
#    Free tier: 200 emails/month (plenty for a portfolio)
#
# 2. Create an Email Service:
#    Dashboard → Email Services → Add New Service
#    → Choose Gmail (easiest) or SMTP for iCloud
#    → Connect with OAuth / credentials
#    → Copy the Service ID shown (e.g. service_abc123)
#
# 3. Create an Email Template:
#    Dashboard → Email Templates → Create New Template
#    → Set "To Email" to: eugeniobrb@icloud.com
#    → Set Subject to: New message from {{from_name}}
#    → Set Body to:
#        From: {{from_name}} <{{from_email}}>
#
#        {{message}}
#
#    → Save → copy the Template ID (e.g. template_abc123)
#
# 4. Get your Public Key:
#    Dashboard → Account → API Keys → Public Key (e.g. abc123xyz)
#    NOTE: EmailJS public keys are DESIGNED to be public-facing.
#    They're not secrets — the service restricts usage by domain.
#
# 5. Copy this file to .env.local and fill in your values:
#    cp .env.local.example .env.local
#
# ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_XXXXXXXX
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_XXXXXXXX
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=XXXXXXXXXXXXXXXXX
